# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/automation?sslmode=disable

# HTTP Server
PORT=8080

# Delivery Worker Configuration
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4

# Retry and Backoff Policy
MAX_RETRIES=3
INITIAL_BACKOFF=2s
MAX_BACKOFF=1m

# Telegram Integration
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Enable the Telegram long-poll listener (requires TELEGRAM_BOT_TOKEN).
TELEGRAM_ENABLED=true
# Optional: override the Bot API base URL (useful for local Bot API servers / tests).
TELEGRAM_API_BASE_URL=
# Long-poll timeout (seconds) for getUpdates.
TELEGRAM_POLL_TIMEOUT=30
# How long to buffer updates that share a media_group_id before mirroring the album.
TELEGRAM_MEDIA_GROUP_WINDOW=1s
# Telegram rate limiting: global messages/second and per-destination-chat messages/second.
TELEGRAM_RATE_GLOBAL=25
TELEGRAM_RATE_PER_CHAT=1

# Logging and Environment
LOG_LEVEL=info
ENVIRONMENT=development
