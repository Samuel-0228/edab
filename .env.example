# ==============================================================================
# Kerob Automation Platform - Environment Configuration Example
# ==============================================================================

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgres://kerob:kerob_password@localhost:5432/kerob?sslmode=disable

# HTTP Server Port
PORT=8080

# Frontend Development Proxy URL
# Target backend API URL when running the Vite frontend standalone via 'npm run dev'.
VITE_BACKEND_URL=http://localhost:8080

# Management API Security
# Optional in development mode.
# Required when ENVIRONMENT=production (send as Authorization: Bearer <API_TOKEN>).
# Production requires a secure secret token (minimum 16 characters; defaults/placeholders rejected).
API_TOKEN=

# Credential Encryption at Rest (AES-256-GCM)
# 32-byte secret key used to encrypt integration tokens and API keys at rest.
# Optional in development (uses internal local fallback key if blank).
KEROB_ENCRYPTION_KEY=

# Execution Worker & Queue Configuration
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_ID=
WORKFLOW_WORKER_CONCURRENCY=4
WORKFLOW_WORKER_POLL_INTERVAL=1s
WORKFLOW_WORKER_ENABLED=true
MAX_RETRIES=3
INITIAL_BACKOFF=2s
MAX_BACKOFF=1m

# Telegram Adapter Configuration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_API_BASE_URL=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_MEDIA_GROUP_WINDOW=1s
TELEGRAM_RATE_GLOBAL=25
TELEGRAM_RATE_PER_CHAT=1
TELEGRAM_PUBLIC_POLL_INTERVAL=15s

# Logging & Environment Mode (development | production)
LOG_LEVEL=info
ENVIRONMENT=development

# Multi-Tenancy & RBAC Configuration
# When false (default), runs in single-tenant mode with automatic default tenant context.
# When true, strictly enforces tenant boundaries, memberships, and RBAC permissions.
MULTI_TENANCY_ENABLED=false
DEFAULT_TENANT_ID=default

# Error Tracking & Sentry Telemetry (Optional)
# Sentry DSN for capturing unhandled exceptions with automatic secret scrubbing.
SENTRY_DSN=

# Outbound SSRF Policy (Optional)
# Path to local IP/domain policy configuration file
POLICY_FILE=

# OpenTelemetry Tracing (Optional)
# Standard OTLP/HTTP collector endpoint (e.g. http://localhost:4318).
# When unset, OpenTelemetry tracing defaults to an in-memory no-op tracer with zero overhead.
OTEL_EXPORTER_OTLP_ENDPOINT=
