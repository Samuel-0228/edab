# ==============================================================================
# Kerob Automation Platform - Environment Configuration Example
# ==============================================================================

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgres://kerob:kerob_password@localhost:5432/kerob?sslmode=disable

# HTTP Server Port
PORT=8080

# Frontend Development Proxy URL
# Target backend API URL when running the Vite frontend standalone via 'npm run dev'.
VITE_BACKEND_URL=http://localhost:8080

# Management API Security
# Optional in development mode.
# Required when ENVIRONMENT=production (send as Authorization: Bearer <API_TOKEN>).
# Production requires a secure secret token (minimum 16 characters; defaults/placeholders rejected).
API_TOKEN=

# Credential Encryption at Rest (AES-256-GCM)
# 32-byte secret key used to encrypt integration tokens and API keys at rest.
# Optional in development (uses internal local fallback key if blank).
KEROB_ENCRYPTION_KEY=

# Execution Worker & Queue Configuration
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4
MAX_RETRIES=3
INITIAL_BACKOFF=2s
MAX_BACKOFF=1m

# Telegram Adapter Configuration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_API_BASE_URL=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_MEDIA_GROUP_WINDOW=1s
TELEGRAM_RATE_GLOBAL=25
TELEGRAM_RATE_PER_CHAT=1
TELEGRAM_PUBLIC_POLL_INTERVAL=15s

# Logging & Environment Mode (development | production)
LOG_LEVEL=info
ENVIRONMENT=development
