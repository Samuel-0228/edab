# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/automation?sslmode=disable

# HTTP Server
PORT=8080
# Required when ENVIRONMENT=production. Send as Authorization: Bearer <token>.
API_TOKEN=

# Delivery Worker Configuration
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4

# Retry and Backoff Policy
MAX_RETRIES=3
INITIAL_BACKOFF=2s
MAX_BACKOFF=1m

# Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
TELEGRAM_API_BASE_URL=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_MEDIA_GROUP_WINDOW=1s
TELEGRAM_RATE_GLOBAL=25
TELEGRAM_RATE_PER_CHAT=1

# Logging and Environment
LOG_LEVEL=info
ENVIRONMENT=development
